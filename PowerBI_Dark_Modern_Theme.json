{
  "name": "SME Capital Matching — Dark Modern",
  "dataColors": ["#2DD4BF", "#F59E0B", "#F87171", "#60A5FA", "#A78BFA", "#34D399", "#FBBF24", "#F472B6", "#94A3B8", "#22D3EE"],
  "background": "#0F172A",
  "foreground": "#E2E8F0",
  "tableAccent": "#2DD4BF",
  "good": "#2DD4BF",
  "neutral": "#F59E0B",
  "bad": "#F87171",
  "maximum": "#2DD4BF",
  "center": "#F59E0B",
  "minimum": "#F87171",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#F1F5F9" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#E2E8F0" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#E2E8F0" },
    "label": { "fontSize": 9, "fontFace": "Segoe UI", "color": "#CBD5E1" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#1E293B" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#334155" } }, "radius": 8 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#E2E8F0" } }, "background": { "solid": { "color": "#1E293B" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }],
        "labels": [{ "color": { "solid": { "color": "#CBD5E1" } }, "fontSize": 9 }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#94A3B8" } }, "gridlineColor": { "solid": { "color": "#334155" } }, "titleColor": { "solid": { "color": "#94A3B8" } } }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#94A3B8" } }, "gridlineColor": { "solid": { "color": "#334155" } }, "titleColor": { "solid": { "color": "#94A3B8" } } }],
        "legend": [{ "labelColor": { "solid": { "color": "#CBD5E1" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0F172A" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#0B1120" } }, "transparency": 0 }]
      }
    }
  }
}
